[Unit]
Description=HA Photo Kiosk Google Photos OAuth (rclone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiosk
Group=kiosk
# Runs rclone config create in the FOREGROUND so it survives as this service
# (a background child would be killed with the cgroup). It prints the OAuth URL
# and launches a SEPARATE interactive browser window on the kiosk display for
# the login (the kiosk browser stays at /frame/). When the user approves,
# rclone completes and this service exits.
Environment=CONFIG_DIR=/home/kiosk/config
Environment=PHOTO_DIR=/home/kiosk/photos
Environment=DISPLAY=:0
Environment=XAUTHORITY=/var/run/kiosk.auth
ExecStart=/home/kiosk/bin/kiosk-gphotos-sync.sh auth-run