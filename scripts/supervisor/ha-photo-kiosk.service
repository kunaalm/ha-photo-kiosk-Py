[Unit]
Description=HA Photo Kiosk supervisor (Chromium kiosk at engine /frame/)
# The engine container must be up first; the supervisor waits for it anyway,
# but ordering avoids a race at boot.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated kiosk user (create with: useradd -m kiosk)
User=kiosk
Group=kiosk
PAMName=login
Environment=XDG_RUNTIME_DIR=/run/user/%U
# Start X on vt7 (no display manager) and run the Openbox session; Openbox's
# autostart launches the supervisor, which opens Chromium at the kiosk page.
ExecStart=/usr/bin/xinit /usr/bin/openbox-session -- :0 vt7 -nolisten tcp -nocursor -auth /var/run/kiosk.auth
# Restart the whole X session if it dies (belt-and-braces on top of the
# supervisor's own Chromium-restart loop).
Restart=always
RestartSec=5
# Give the supervisor a clean TTY so Chromium can grab input.
StandardInput=tty
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
